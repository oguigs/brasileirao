{
  "datasets": [
    {
      "name": "2c55793f",
      "displayName": "ds_resumo",
      "queryLines": [
        "SELECT\n",
        "  min_by(time, posicao)             AS lider,\n",
        "  min_by(pontos, posicao)          AS pontos_lider,\n",
        "  max_by(time, pct_titulo)         AS favorito,\n",
        "  max(pct_titulo)                  AS pct_favorito,\n",
        "  min_by(jogos_restantes, posicao) AS jogos_restantes,\n",
        "  max(simulacoes)                  AS simulacoes,\n",
        "  max(calculado_em)                AS calculado_em,\n",
        "  (SELECT time   FROM workspace.brasileirao_gold.tabela_final ORDER BY posicao LIMIT 1 OFFSET 1) AS segundo,\n",
        "  (SELECT pontos FROM workspace.brasileirao_gold.tabela_final ORDER BY posicao LIMIT 1 OFFSET 1) AS pontos_segundo,\n",
        "  (SELECT pontos FROM workspace.brasileirao_gold.tabela_final ORDER BY posicao LIMIT 1)\n",
        "  -\n",
        "  (SELECT pontos FROM workspace.brasileirao_gold.tabela_final ORDER BY posicao LIMIT 1 OFFSET 1)  AS diferenca_primeiro\n",
        "FROM workspace.brasileirao_gold.tabela_final"
      ]
    },
    {
      "name": "7cda43bb",
      "displayName": "ds_tabela_final",
      "queryLines": [
        "SELECT posicao, time, jogos, pontos, saldo, jogos_restantes,\n",
        "       pontos_esperados, posicao_mais_provavel,\n",
        "       pct_titulo, pct_top5, pct_rebaixamento,\n",
        "       melhor_posicao, pior_posicao, calculado_em\n",
        "FROM workspace.brasileirao_gold.tabela_final\n",
        "ORDER BY posicao\n"
      ]
    },
    {
      "name": "5869122b",
      "displayName": "ds_distribuicao",
      "queryLines": [
        "-- chance de cada time terminar em cada posição (1 a 20)\n",
        "-- time_ordem (\"01º Flamengo\") faz o eixo Y seguir a ordem da tabela\n",
        "SELECT p.time,\n",
        "       concat(lpad(cast(t.posicao AS STRING), 2, '0'), 'º ', p.time) AS time_ordem,\n",
        "       t.posicao AS posicao_atual, t.pontos,\n",
        "       d.pos + 1 AS posicao, round(100 * d.prob, 2) AS pct\n",
        "FROM workspace.brasileirao_gold.projecao_final p\n",
        "JOIN workspace.brasileirao_gold.tabela_final t USING (time)\n",
        "LATERAL VIEW posexplode(p.dist_posicoes) d AS pos, prob"
      ]
    },
    {
      "name": "928ae326",
      "displayName": "ds_faixa_pontos",
      "queryLines": [
        "-- pontos esperados com a faixa de incerteza (10% e 90% das simulações)\n",
        "SELECT p.time, t.posicao, p.pontos_atuais,\n",
        "       round(p.pontos_esperados, 1) AS pontos_esperados,\n",
        "       p.pontos_p10, p.pontos_p90\n",
        "FROM workspace.brasileirao_gold.projecao_final p\n",
        "JOIN workspace.brasileirao_gold.tabela_final t USING (time)\n",
        "ORDER BY t.posicao\n"
      ]
    },
    {
      "name": "b22b0a0f",
      "displayName": "ds_evolucao",
      "queryLines": [
        "-- uma linha por time a cada execução do pipeline\n",
        "SELECT data_ref AS calculado_em, time,\n",
        "       round(100 * p_titulo, 1)       AS pct_titulo,\n",
        "       round(100 * p_z4, 1)           AS pct_rebaixamento,\n",
        "       round(pontos_esperados, 1)     AS pontos_esperados\n",
        "FROM workspace.brasileirao_gold.historico_projecoes\n"
      ]
    },
    {
      "name": "c823ffa0",
      "displayName": "ds_prob_jogos",
      "queryLines": [
        "-- dados processados: o campeonato de 2012 a 2026, temporada a temporada\n",
        "SELECT temporada,\n",
        "       count(*) AS jogos,\n",
        "       round(avg(gols_mandante + gols_visitante), 2) AS media_gols,\n",
        "       round(100 * avg(CASE WHEN gols_mandante > gols_visitante THEN 1 ELSE 0 END), 1) AS pct_vitoria_mandante,\n",
        "       round(100 * avg(CASE WHEN gols_mandante = gols_visitante THEN 1 ELSE 0 END), 1) AS pct_empate,\n",
        "       round(100 * avg(CASE WHEN gols_mandante < gols_visitante THEN 1 ELSE 0 END), 1) AS pct_vitoria_visitante\n",
        "FROM workspace.brasileirao_silver.partidas\n",
        "GROUP BY temporada\n",
        "ORDER BY temporada\n"
      ]
    },
    {
      "name": "2bdca33a",
      "displayName": "ds_temporadas",
      "queryLines": [
        "-- dados processados: o campeonato de 2012 a 2026, temporada a temporada\n",
        "SELECT temporada,\n",
        "       count(*) AS jogos,\n",
        "       round(avg(gols_mandante + gols_visitante), 2) AS media_gols,\n",
        "       round(100 * avg(CASE WHEN gols_mandante > gols_visitante THEN 1 ELSE 0 END), 1) AS pct_vitoria_mandante,\n",
        "       round(100 * avg(CASE WHEN gols_mandante = gols_visitante THEN 1 ELSE 0 END), 1) AS pct_empate,\n",
        "       round(100 * avg(CASE WHEN gols_mandante < gols_visitante THEN 1 ELSE 0 END), 1) AS pct_vitoria_visitante\n",
        "FROM workspace.brasileirao_silver.partidas\n",
        "GROUP BY temporada\n",
        "ORDER BY temporada\n"
      ]
    },
    {
      "name": "54c934d7",
      "displayName": "ds_forcas",
      "queryLines": [
        "-- ataque e defesa estimados pelo modelo no último treino (quanto maior, melhor nos dois)\n",
        "SELECT f.time, t.posicao,\n",
        "       round(f.ataque, 3) AS ataque,\n",
        "       round(f.defesa, 3) AS defesa\n",
        "FROM workspace.brasileirao_gold.modelo_forcas f\n",
        "JOIN workspace.brasileirao_gold.tabela_final t USING (time)\n",
        "WHERE f.run_id = (SELECT max_by(run_id, data_ref) FROM workspace.brasileirao_gold.modelo_forcas)\n"
      ]
    },
    {
      "name": "e1eb44d1",
      "displayName": "ds_backtest",
      "queryLines": [
        "-- erro das previsões no último backtest (RPS: quanto menor, melhor)\n",
        "WITH ultimo AS (\n",
        "  SELECT * FROM workspace.brasileirao_gold.backtest_metricas\n",
        "  ORDER BY calculado_em DESC LIMIT 1\n",
        ")\n",
        "SELECT 'Modelo' AS previsao, round(rps_modelo, 4) AS rps FROM ultimo\n",
        "UNION ALL\n",
        "SELECT 'Média da liga', round(rps_media_liga, 4) FROM ultimo\n",
        "UNION ALL\n",
        "SELECT 'Mercado (odds)', round(rps_mercado, 4) FROM ultimo\n"
      ]
    },
    {
      "name": "df227d98",
      "displayName": "ds_execucoes",
      "queryLines": [
        "SELECT registrado_em, job_nome, gatilho, status, detalhes\n",
        "FROM workspace.brasileirao_ops.execucoes\n",
        "ORDER BY registrado_em DESC\n"
      ]
    }
  ],
